# RESTCONF lab credentials & target for the Episode 4 scripts.
#
# Copy this file to `.env` and adjust as needed, then load it into your shell:
#
#   cp .env.example .env
#   set -a; source .env; set +a
#
# Each script reads these environment variables (they override the defaults
# baked into the script). Fill in the credentials for your device — the DevNet
# Cat8k always-on sandbox generates a unique username/password per session.

# --- Credentials ---
export RESTCONF_USER="<USERNAME>"
export RESTCONF_PASS="<PASSWORD>"

# --- Target device (optional overrides) ---
export RESTCONF_HOST="devnetsandboxiosxec8k.cisco.com"
export RESTCONF_PORT="443"
