# Credentials for the Episode 6 demos.
#
# Copy this file to `.env` and fill in your values:
#
#   cp .env.example .env
#
# The scripts read it with python-dotenv (load_dotenv), so there is nothing to
# export or source. Never commit your real .env -- it is in .gitignore.

# --- Meraki (Demos 2 and 3) ---
# Dashboard -> My Profile -> API access -> Generate key
MERAKI_API_KEY="<YOUR-MERAKI-API-KEY>"
# Set ORG_NAME in 02_meraki_requests.py and run it; step 1 prints that org's ID.
MERAKI_ORG_ID="<YOUR-ORG-ID>"

# --- Webex (Demo 4) ---
# developer.webex.com -> My Webex Apps -> Create a Bot -> copy the access token
WEBEX_BOT_TOKEN="<YOUR-BOT-TOKEN>"
# Exact title of a space the bot has been added to.
WEBEX_ROOM_TITLE="CCNA Automation Prep"
